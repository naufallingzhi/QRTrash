<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4FBF7"
    tools:context=".activity_main">

    <!-- ================= KONTEN UTAMA (SCROLLABLE) ================= -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="110dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ================= HEADER: PROFIL & NOTIFIKASI ================= -->
            <!-- Kotak Putih Pembungkus Avatar -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAvatarContainer"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="28dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="6dp"
                app:strokeWidth="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Lingkaran Dalam Avatar -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="center"
                    app:cardBackgroundColor="#E0F2FE"
                    app:cardCornerRadius="21dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <!-- TEMPLATE GAMBAR 1: Ganti src dengan foto profil/avatar kamu -->
                    <ImageView
                        android:id="@+id/ivAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/profile" />
                </com.google.android.material.card.MaterialCardView>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:fontFamily="@font/monasansbold"
                android:text="Hallo, Naufal Lingzhi"
                android:textColor="#1E293B"
                android:textSize="16sp"
                app:layout_constraintBottom_toTopOf="@+id/tvLocation"
                app:layout_constraintStart_toEndOf="@+id/cardAvatarContainer"
                app:layout_constraintTop_toTopOf="@+id/cardAvatarContainer"
                app:layout_constraintVertical_chainStyle="packed" />

            <TextView
                android:id="@+id/tvLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/monasanssemibold"
                android:text="Pekanbaru, Riau"
                android:textColor="#475569"
                android:textSize="11sp"
                app:layout_constraintBottom_toBottomOf="@+id/cardAvatarContainer"
                app:layout_constraintStart_toStartOf="@+id/tvGreeting"
                app:layout_constraintTop_toBottomOf="@+id/tvGreeting" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnNotification"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="24dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="6dp"
                app:strokeWidth="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/cardAvatarContainer"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/cardAvatarContainer">

                <!-- TEMPLATE GAMBAR 2: Ganti src dengan icon lonceng notifikasi -->
                <ImageView
                    android:id="@+id/ivNotification"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_notification"
                    app:tint="#64748B" />
            </com.google.android.material.card.MaterialCardView>

            <!-- ================= KARTU BANNER HIJAU ================= -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBanner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="#15803D"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:strokeWidth="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cardAvatarContainer">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="22dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/badgeAksi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#1E9E52"
                        app:cardCornerRadius="50dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#4ADE80"
                        app:strokeWidth="1dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/monasanssemibold"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"
                            android:text="Aksi Cepat Warga"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvBannerTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/monasansbold"
                        android:lineSpacingExtra="2dp"
                        android:text="Ada masalah\ndi tempat sampah?"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/badgeAksi" />

                    <TextView
                        android:id="@+id/tvBannerDesc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/monasansregular"
                        android:lineSpacingExtra="2dp"
                        android:text="Pindai kode pada fasilitas dan kirim\nlaporan kurang dari satu menit."
                        android:textColor="#DCFCE7"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvBannerTitle" />

                    <!-- Tombol Scan di dalam Banner -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnScanBanner"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="20dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp"
                        app:layout_constraintTop_toBottomOf="@+id/tvBannerDesc">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:paddingHorizontal="10dp">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/boxQrIcon"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                app:cardBackgroundColor="#22C55E"
                                app:cardCornerRadius="10dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent">

                                <!-- TEMPLATE GAMBAR 3: Ganti src dengan icon QR Code -->
                                <ImageView
                                    android:id="@+id/ivScanIconCard"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_qr"
                                    app:tint="#0F172A" />
                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:fontFamily="@font/monasansbold"
                                android:text="Scan QR Tempat Sampah"
                                android:textColor="#15803D"
                                android:textSize="13sp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/boxQrIcon"
                                app:layout_constraintTop_toTopOf="parent" />

                            <!-- TEMPLATE GAMBAR 4: Ganti src dengan icon panah kanan (chevron right) -->
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginEnd="4dp"
                                android:src="@drawable/ic_next"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ================= BANNER INFO (HIJAU MINT) ================= -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#ECFDF5"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#86EFAC"
                app:strokeWidth="1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cardBanner">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <!-- TEMPLATE GAMBAR 5: Ganti src dengan icon bintang/sparkle -->
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@android:drawable/ic_menu_info_details"
                        app:tint="#94A3B8" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/monasansregular"
                        android:lineSpacingExtra="2dp"
                        android:text="Terima kasih! Anda sudah membantu menjaga 8 titik fasilitas kota."
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ================= SEKSI LAPORAN SAYA ================= -->
            <TextView
                android:id="@+id/tvStatsSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/monasanssemibold"
                android:text="Ringkasan bulan ini"
                android:textColor="#22C55E"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cardInfo" />

            <TextView
                android:id="@+id/tvStatsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/monasansbold"
                android:text="Laporan Saya"
                android:textColor="#1E293B"
                android:textSize="20sp"
                app:layout_constraintStart_toStartOf="@+id/tvStatsSub"
                app:layout_constraintTop_toBottomOf="@+id/tvStatsSub" />

            <TextView
                android:id="@+id/tvViewAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:fontFamily="@font/monasanssemibold"
                android:text="Lihat semua"
                android:textColor="#16A34A"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="@+id/tvStatsTitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvStatsTitle" />

            <!-- DUA KARTU RINGKASAN -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingBottom="12dp"
                android:weightSum="2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvStatsTitle">

                <!-- KARTU 1: Laporan Diproses -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="8dp"
                    app:strokeWidth="0dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="18dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/iconProcess"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            app:cardBackgroundColor="#FEF3C7"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <!-- TEMPLATE GAMBAR 6: Ganti src dengan icon jam kuning -->
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_clock2"
                                app:tint="#D97706" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tvProcessNum"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:fontFamily="@font/monasansbold"
                            android:text="03"
                            android:textColor="#0F172A"
                            android:textSize="30sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/iconProcess" />

                        <TextView
                            android:id="@+id/tvProcessText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFamily="@font/monasanssemibold"
                            android:lineSpacingExtra="2dp"
                            android:text="Laporan\nDiproses"
                            android:textColor="#1E293B"
                            android:textSize="11sp"
                            app:layout_constraintBottom_toBottomOf="@+id/tvProcessNum"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/tvProcessNum"
                            app:layout_constraintTop_toTopOf="@+id/tvProcessNum" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:fontFamily="@font/monasansbold"
                            android:text="+1 minggu ini"
                            android:textColor="#0F172A"
                            android:textSize="11sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tvProcessNum" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- KARTU 2: Laporan Selesai -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="8dp"
                    app:strokeWidth="0dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="18dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/iconDone"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            app:cardBackgroundColor="#DCFCE7"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <!-- TEMPLATE GAMBAR 7: Ganti src dengan icon centang hijau -->
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_check"
                                app:tint="#22C55E" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tvDoneNum"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:fontFamily="@font/monasansbold"
                            android:text="12"
                            android:textColor="#0F172A"
                            android:textSize="30sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/iconDone" />

                        <TextView
                            android:id="@+id/tvDoneText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFamily="@font/monasanssemibold"
                            android:lineSpacingExtra="2dp"
                            android:text="Laporan\nSelesai"
                            android:textColor="#1E293B"
                            android:textSize="11sp"
                            app:layout_constraintBottom_toBottomOf="@+id/tvDoneNum"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/tvDoneNum"
                            app:layout_constraintTop_toTopOf="@+id/tvDoneNum" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:fontFamily="@font/monasansbold"
                            android:text="80% tuntas"
                            android:textColor="#0F172A"
                            android:textSize="11sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tvDoneNum" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- ================= FLOATING BOTTOM NAVIGATION BAR ================= -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomNavContainer"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="28dp"
        app:cardElevation="12dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:weightSum="5">

            <!-- Menu 1: Beranda -->
            <LinearLayout
                android:id="@+id/navBeranda"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <!-- TEMPLATE GAMBAR 8: Ganti src dengan icon Beranda (Home) -->
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_home"
                    app:tint="#0F172A" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/monasansregular"
                    android:text="Beranda"
                    android:textColor="#0F172A"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Menu 2: Aktivitas -->
            <LinearLayout
                android:id="@+id/navAktivitas"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <!-- TEMPLATE GAMBAR 9: Ganti src dengan icon Aktivitas (Jam) -->
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_clock"
                    app:tint="#0F172A" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/monasansregular"
                    android:text="Aktivitas"
                    android:textColor="#0F172A"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Ruang Kosong untuk Tombol QR di Tengah -->
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <!-- Menu 4: Peta TPS -->
            <LinearLayout
                android:id="@+id/navPeta"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <!-- TEMPLATE GAMBAR 10: Ganti src dengan icon Peta (Pin Lokasi) -->
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_peta"
                    app:tint="#0F172A" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/monasansregular"
                    android:text="Peta TPS"
                    android:textColor="#0F172A"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Menu 5: Profil -->
            <LinearLayout
                android:id="@+id/navProfil"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <!-- TEMPLATE GAMBAR 11: Ganti src dengan icon Profil (User) -->
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_profile"
                    app:tint="#0F172A" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/monasansregular"
                    android:text="Profil"
                    android:textColor="#0F172A"
                    android:textSize="10sp" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ================= TOMBOL QR MELAYANG DI TENGAH ================= -->
    <!-- Bingkai Luar Putih/Abu-abu Lembut -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/fabMainScanOuter"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_marginBottom="28dp"
        app:cardBackgroundColor="#F8FAFC"
        app:cardCornerRadius="20dp"
        app:cardElevation="16dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Kotak Dalam Hijau Terang -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/fabMainScan"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="center"
            app:cardBackgroundColor="#22C55E"
            app:cardCornerRadius="15dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <!-- TEMPLATE GAMBAR 12: Ganti src dengan icon QR Scanner utama -->
            <ImageView
                android:layout_width="30dp"
