<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4FBF7"
    android:padding="20dp">

    <!-- Header Ringkasan Wilayah Hari Ini -->
    <TextView
        android:id="@+id/tvHariHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/monasansbold"
        android:text="Jadwal Operasional Hari Senin"
        android:textColor="#0F172A"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvSubHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/monasansregular"
        android:text="3 Shift Pengangkutan Armada DLHK Pekanbaru (Pagi, Siang, Sore)"
        android:textColor="#64748B"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvHariHeader" />

    <!-- ================= KARTU 1: JADWAL PAGI ================= -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPagi"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="18dp"
        app:cardElevation="3dp"
        app:strokeColor="#86EFAC"
        app:strokeWidth="1.5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvSubHeader">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/badgePagi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#DCFCE7"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/monasansbold"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="SHIFT PAGI"
                    android:textColor="#15803D"
                    android:textSize="10sp" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvJamPagi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/monasansbold"
                android:text="06.00 - 09.00 WIB"
                android:textColor="#15803D"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="@+id/badgePagi"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/badgePagi" />

            <TextView
                android:id="@+id/tvRutePagi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/monasansbold"
                android:text="Rute Wilayah Pagi"
                android:textColor="#1E293B"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/badgePagi" />

            <TextView
                android:id="@+id/tvArmadaPagi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/monasansregular"
                android:text="Armada Truk Pagi"
                android:textColor="#475569"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvRutePagi" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ================= KARTU 2: JADWAL SIANG ================= -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSiang"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="18dp"
        app:cardElevation="3dp"
        app:strokeColor="#BAE6FD"
        app:strokeWidth="1.5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardPagi">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/badgeSiang"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#E0F2FE"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/monasansbold"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="SHIFT SIANG"
                    android:textColor="#0284C7"
                    android:textSize="10sp" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvJamSiang"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/monasansbold"
                android:text="11.30 - 14.00 WIB"
                android:textColor="#0284C7"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="@+id/badgeSiang"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/badgeSiang" />

            <TextView
                android:id="@+id/tvRuteSiang"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/monasansbold"
                android:text="Rute Wilayah Siang"
                android:textColor="#1E293B"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/badgeSiang" />

            <TextView
                android:id="@+id/tvArmadaSiang"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/monasansregular"
                android:text="Armada Truk Siang"
                android:textColor="#475569"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvRuteSiang" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ================= KARTU 3: JADWAL SORE ================= -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSore"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="18dp"
        app:cardElevation="3dp"
        app:strokeColor="#FDE68A"
        app:strokeWidth="1.5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardSiang">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/badgeSore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FEF3C7"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/monasansbold"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="SHIFT SORE"
                    android:textColor="#D97706"
                    android:textSize="10sp" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvJamSore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/monasansbold"
                android:text="16.00 - 18.30 WIB"
                android:textColor="#D97706"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="@+id/badgeSore"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/badgeSore" />

            <TextView
                android:id="@+id/tvRuteSore"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/monasansbold"
                android:text="Rute Wilayah Sore"
                android:textColor="#1E293B"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/badgeSore" />

            <TextView
                android:id="@+id/tvArmadaSore"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/monasansregular"
                android:text="Armada Truk Sore"
                android:textColor="#475569"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvRuteSore" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>